# Butler settings: the ONE file to edit. Copy to butler.env (git-ignored):  ./bt.sh init
# Sourced by sh: no spaces around '=', and single-quote values with special characters.
# A key left empty or commented out keeps its default.

# ==========================================================================================================
# 1. THIS MACHINE                    used by bt.sh and the bridge (../hooks/butler-bridge.py); nothing reaches the board
# ==========================================================================================================
IDF_ACTIVATE="$HOME/.espressif/tools/activate_idf_v6.1.sh"   # ESP-IDF v6.1 from EIM (not needed if IDF is exported)
IDF_TARGET=esp32c6                                           # the chip: esp32c6, esp32s3, esp32c3, esp32, ...
ESPPORT=/dev/cu.usbmodemXXXXXXXXXXX                          # the board's USB-UART port (README.md, "Find the port")
# ESPBAUD=460800                                              # optional, flashing speed

# ==========================================================================================================
# 2. BOARD SETTINGS                  -> the board's settings storage (NVS partition), all optional
#    apply with:  ./bt.sh provision flash-nvs                 no rebuild
# ==========================================================================================================
# --- The value shown is the default ----------------------------------------------------------------------
BT_LED_BRIGHTNESS_PCT=10                  # 1-100
BT_WORKING_STALE_S=1800                   # "working" with no news for this long shows as idle (Esc sends no hook)
BT_SESSION_TTL_S=43200                    # an agent with no news for this long is forgotten
